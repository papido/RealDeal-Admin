{
  "expo": {
    "name": "RealDeal Admin",
    "slug": "RealDeal",
    "version": "1.0.0",
    "entryPoint": "./src/app/index.tsx",
    "orientation": "portrait",
    "icon": "./assets/images/adminIcon.png",
    "scheme": "realdeal",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splashImage.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adminIcon.png",
        "backgroundColor": "#ffffff",
        "resizeMode": "contain"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.fauzanafk.realdealadmin",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/iconImage.png"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splashImage.png",
          "resizeMode": "cover",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-firebase/app",
      [
        "@react-native-firebase/messaging",
        {
          "ios": {
            "useFrameworkSystemDefault": false
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3ee1b712-c40c-4f1f-bf53-c132e5b3cb36"
      }
    },
    "owner": "fauzanafk"
  }
}
